#!name=小红书去明确广告与隐藏市集
#!desc=保留明确广告过滤和标题类型标记；隐藏可识别的市集导航；支持 edith、www、rec，保留脱敏结构记录。
#!category=Custom

# 配套 JS 内容需由用户上传至下方固定的远端 script-path。
# 替换使用时停用旧版小红书模块及其他匹配相同接口的响应脚本。
[Script]
小红书自定义 = type=http-response,pattern=^https:\/\/(?:edith|www|rec)\.xiaohongshu\.com\/api\/sns\/(?:v1\/note\/imagefeed|v2\/note\/(?:feed|widgets)|v[34]\/note\/videofeed|v2\/system_service\/splash_config|v1\/system_service\/config|v6\/homefeed|v1\/localfeed(?:\/(?:header|tab_config))?)(?:\?|$),requires-body=true,max-size=2097152,script-path=https://raw.githubusercontent.com/0ee/Rules/Surge/Script/XiaoHongshu.js,timeout=5

[Map Local]
# 原有惊喜弹窗规则：补充 edith 和无查询参数形式。日志尚未捕获此接口。
# 不拦截 surprisebox/submit_action 操作提交接口。
^https:\/\/(?:edith|www|rec)\.xiaohongshu\.com\/api\/marketing\/box\/trigger(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
# 广告资源预加载接口，返回与已观察响应一致的成功信封及空列表。
^https:\/\/(?:edith|www|rec)\.xiaohongshu\.com\/api\/sns\/v1\/ads\/resource(?:\?|$) data-type=base64 data="eyJjb2RlIjowLCJzdWNjZXNzIjp0cnVlLCJtc2ciOiIiLCJkYXRhIjpbXX0=" status-code=200 header="Content-Type:application/json; charset=utf-8"

[MITM]
hostname = %APPEND% edith.xiaohongshu.com, www.xiaohongshu.com, rec.xiaohongshu.com
