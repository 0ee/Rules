#!name=小红书去广告 
#!desc=小红书APP去开屏、信息流、搜索页广告、照片视频去水印
#!category=Custom

[Script]
小红书记录 = type=http-response,pattern=^https:\/\/www\.xiaohongshu\.com\/api\/*,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/0ee/Rules/Surge/Script/XiaoHongshu.js

[Map Local]
# 惊喜弹窗
^https:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\? data="https://raw.githubusercontent.com/0ee/Rules/Surge/empty-body.json"
# 信息流
^https:\/\/www\.xiaohongshu\.com\/api\/sns\/v1\/ads\/resource\? data="https://raw.githubusercontent.com/0ee/Rules/Surge/empty-body.json"

[MITM]
hostname = %APPEND% www.xiaohongshu.com