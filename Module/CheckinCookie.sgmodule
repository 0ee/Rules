#!name=Checkin
#!desc=Get Checkin Cookie
#!system=ios
#!category=Checkin


[Script]
阿里云盘 Cookie = type=http-response,pattern=https:\/\/auth.aliyundrive.com\/v2\/account\/token,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/lowking/Scripts/master/ali/aliYunPanCheckIn.js

阿里云盘每日 Cookie = type=http-request, pattern=^https:\/\/(auth|aliyundrive)\.alipan\.com\/v2\/account\/token, script-path=https://gist.githubusercontent.com/Sliverkiss/33800a98dcd029ba09f8b6fc6f0f5162/raw/aliyun.js, requires-body=true, max-size=-1, timeout=60
阿里云盘签到 Cookie = type=http-request, pattern=https://member.aliyundrive.com/v1/activity/sign_in_reward, script-path=https://raw.githubusercontent.com/0ee/Rules/Surge/Script/AliDrive.SignIn.js, requires-body=true, max-size=-1, timeout=60

B站Cookie(APP) = type=http-request,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/fingerprint\?,script-path=https://raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js,requires-body=0

B站Cookie(网页) = type=http-request,pattern=^https?:\/\/m\.bilibili\.com/$,script-path=https://raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js,requires-body=0

原神签到Cookie = type=http-request,pattern=^https://api-takumi.mihoyo.com/event/luna/hk4e/home,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/0ee/Rules/Surge/Script/MiYouShe.cookie.js
米游币任务Cookie = type=http-request,pattern=^https://bbs-api.miyoushe.com/timeline/api/getUnreadInfo,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/0ee/Rules/Surge/Script/MiYouShe.cookie.js

库洛币任务Cookie = type=http-request,pattern=^https://api.kurobbs.com/user/login/log,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/0ee/Rules/Surge/Script/Kuro.cookie.js

微博超话 Cookie = type=http-request,pattern=https://api.weibo.cn/2/page/button\?,script-path=https://raw.githubusercontent.com/0ee/Rules/Surge/Script/WeiboSuper.js


[MITM]
hostname = %APPEND% auth.aliyundrive.com, auth.alipan.com, app.bilibili.com, m.bilibili.com, bbs-api.miyoushe.com, api-takumi.mihoyo.com, api.kurobbs.com, api.weibo.cn
