#!name=Checkin
#!desc=Get Checkin Cookie
#!system=ios
#!category=Checkin


[Script]
库洛币任务Cookie = type=http-request,pattern=^https://api.kurobbs.com/user/login/log,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/0ee/Rules/Surge/Script/Kuro.cookie.js

微博超话 Cookie = type=http-request,pattern=https://api.weibo.cn/2/page/button\?,script-path=https://raw.githubusercontent.com/0ee/Rules/Surge/Script/WeiboSuper.js

NGA签到捕获 = type=http-request,pattern=^https://bbs\.nga\.cn/nuke\.php.*genshin,script-path=https://raw.githubusercontent.com/0ee/Rules/Surge/Script/NgaSign.js


[MITM]
hostname = %APPEND% api.kurobbs.com, api.weibo.cn, bbs.nga.cn
